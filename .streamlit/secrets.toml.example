# Streamlit Cloud Secrets Template
# Copy this to .streamlit/secrets.toml and fill in your credentials

[fyers]
APP_ID = "your_fyers_app_id"
SECRET_KEY = "your_fyers_secret_key"
REDIRECT_URI = "http://localhost:8501"

[database]
# Add any database connection strings here if needed
DATABASE_URL = ""

[api]
# Add any API keys here
API_KEY = ""
